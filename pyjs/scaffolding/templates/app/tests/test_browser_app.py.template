import pytest
from pyjs import js
from pyjs.web.dom import document
from pyjs.web.events import Event

from __PYJS_PACKAGE__.__PYJS_PACKAGE__ import App

pytestmark = pytest.mark.pyjs_web


@js
def test_action_button_updates_the_mounted_application():
    document.body.replaceChildren()
    app = App()
    document.body.append(app)

    app.action_button.dispatchEvent(Event("click"))

    assert app.status_text.textContent == "Browser connected"
